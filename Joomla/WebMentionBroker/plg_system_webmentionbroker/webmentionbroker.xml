<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" version="6.0" group="system" method="upgrade">
    <name>plg_system_webmentionbroker</name>
    <description>Unified Webmention sender/receiver broker.</description>

    <version>1.0.0</version>
    <creationDate>2026-08-25</creationDate>
    <author>David (aftertaf)</author>
    <license>http://www.gnu.org/licenses/gpl-3.0.html GNU/GPL</license>
    <authorEmail>contact@aftertaf.mont-gargan.fr</authorEmail>
    <authorUrl>https://aftertaf.mont-gargan.fr</authorUrl>

    <files>
        <filename plugin="webmentionbroker">webmentionbroker.php</filename>
        <folder>sql</folder>
    </files>

    <install>
        <sql>
            <file driver="mysql" charset="utf8mb4">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="enabled" type="radio" label="Enable" default="1">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
