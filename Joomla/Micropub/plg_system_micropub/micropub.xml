<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" version="6.0" group="system" method="upgrade">
    <name>plg_system_micropub</name>
    <author>aftertaf</author>
    <version>1.0.0</version>
    <description>Micropub endpoint for IndieWeb.</description>

    <files>
        <filename plugin="micropub">micropub.php</filename>
        <folder>sql</folder>
    </files>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
</extension>