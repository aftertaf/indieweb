<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" version="6.0" group="content" method="upgrade">
    <name>plg_content_indieweb</name>
    <author>aftertaf</author>
    <version>1.0.2</version>
    <description>IndieWeb microformats injection for Joomla articles (Astroid compatible).</description>

    <files>
        <filename plugin="indieweb">indieweb.php</filename>
    </files>

    <config>
        <fields name="params">
            <fieldset name="basic" label="Basic">
                <field name="debug" type="radio" default="0"
                       label="Debug logging"
                       description="Enable logging to administrator/logs/indieweb.php">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
